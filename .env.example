QDRANT_URL=https://your-qdrant-host:6333
QDRANT_CHAT_COLLECTION=flood_kb_active
RAG_SERVICE_TOKEN=replace-with-a-long-random-secret
RAG_ADMIN_TOKEN=replace-with-a-different-long-random-secret
OPENAI_BASE_URL=https://cheapkeyai.shop/v1
OPENAI_API_KEY=replace-with-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# QDRANT_API_KEY=replace-if-required
# Optional for a custom image or multiple local Qdrant containers:
# QDRANT_CONTAINER=actual-running-container-name
# Optional explicit internal endpoint (takes priority over Docker discovery):
# QDRANT_INTERNAL_URL=http://actual-running-container-name:6333
